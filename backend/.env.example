# TripSync AI Backend Environment Variables Template

# Project
PROJECT_NAME="TripSync AI API"
ENVIRONMENT="development"
DEBUG=true
VERSION="1.0.0"

# Security (Replace in production)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://tripsync-ai.pages.dev"

# Database Connection (Supabase PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./tripsync.db"
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
